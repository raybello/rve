diff --git a/drivers/misc/rve.c b/drivers/misc/rve.c
new file mode 100644
--- /dev/null
+++ b/drivers/misc/rve.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * rve -- sysfs interface for RVE emulator guest services.
+ *
+ * Exposes two read-only files under /sys/kernel/rve/:
+ *   player_id   CSR 0x0be -- 2 (server) or 1 (client)
+ *   sync_rng    CSR 0x0bf -- hardware RNG seed
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/sysfs.h>
+
+static inline u32 rve_read_player_id(void)
+{
+	u32 val;
+	asm volatile("csrr %0, 0x0be" : "=r"(val) :: "memory");
+	return val;
+}
+
+static inline u32 rve_read_rng(void)
+{
+	u32 val;
+	asm volatile("csrr %0, 0x0bf" : "=r"(val) :: "memory");
+	return val;
+}
+
+static ssize_t player_id_show(struct kobject *kobj,
+			      struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", rve_read_player_id());
+}
+
+static ssize_t sync_rng_show(struct kobject *kobj,
+			     struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", rve_read_rng());
+}
+
+static struct kobj_attribute player_id_attr = __ATTR_RO(player_id);
+static struct kobj_attribute sync_rng_attr  = __ATTR_RO(sync_rng);
+
+static struct attribute *rve_attrs[] = {
+	&player_id_attr.attr,
+	&sync_rng_attr.attr,
+	NULL,
+};
+
+static struct attribute_group rve_attr_group = {
+	.attrs = rve_attrs,
+};
+
+static struct kobject *rve_kobj;
+
+static int __init rve_init(void)
+{
+	int ret;
+
+	rve_kobj = kobject_create_and_add("rve", kernel_kobj);
+	if (!rve_kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(rve_kobj, &rve_attr_group);
+	if (ret) {
+		kobject_put(rve_kobj);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void __exit rve_exit(void)
+{
+	sysfs_remove_group(rve_kobj, &rve_attr_group);
+	kobject_put(rve_kobj);
+}
+
+module_init(rve_init);
+module_exit(rve_exit);
+MODULE_LICENSE("GPL");
