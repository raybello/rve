diff --git a/drivers/misc/rvc.c b/drivers/misc/rvc.c
new file mode 100644
--- /dev/null
+++ b/drivers/misc/rvc.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * rvc — sysfs interface for RVE emulator guest services.
+ *
+ * Exposes two read-only files under /sys/kernel/rvc/:
+ *   player_id   CSR 0x0be — 2 (server) or 1 (client)
+ *   sync_rng    CSR 0x0bf — hardware RNG seed
+ */
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/sysfs.h>
+
+#define RVC_CSR_PLAYER_ID  0x0be
+#define RVC_CSR_RNG        0x0bf
+
+static inline u32 rvc_read_player_id(void)
+{
+	u32 val;
+	asm volatile("csrr %0, 0x0be" : "=r"(val) :: "memory");
+	return val;
+}
+
+static inline u32 rvc_read_rng(void)
+{
+	u32 val;
+	asm volatile("csrr %0, 0x0bf" : "=r"(val) :: "memory");
+	return val;
+}
+
+static ssize_t player_id_show(struct kobject *kobj,
+			      struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", rvc_read_player_id());
+}
+
+static ssize_t sync_rng_show(struct kobject *kobj,
+			     struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", rvc_read_rng());
+}
+
+static struct kobj_attribute player_id_attr =
+	__ATTR_RO(player_id);
+
+static struct kobj_attribute sync_rng_attr =
+	__ATTR_RO(sync_rng);
+
+static struct attribute *rvc_attrs[] = {
+	&player_id_attr.attr,
+	&sync_rng_attr.attr,
+	NULL,
+};
+
+static struct attribute_group rvc_attr_group = {
+	.attrs = rvc_attrs,
+};
+
+static struct kobject *rvc_kobj;
+
+static int __init rvc_init(void)
+{
+	int ret;
+
+	rvc_kobj = kobject_create_and_add("rvc", kernel_kobj);
+	if (!rvc_kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(rvc_kobj, &rvc_attr_group);
+	if (ret) {
+		kobject_put(rvc_kobj);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void __exit rvc_exit(void)
+{
+	sysfs_remove_group(rvc_kobj, &rvc_attr_group);
+	kobject_put(rvc_kobj);
+}
+
+module_init(rvc_init);
+module_exit(rvc_exit);
+MODULE_LICENSE("GPL");
