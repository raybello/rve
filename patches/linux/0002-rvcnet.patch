--- a/drivers/net/Kconfig
+++ b/drivers/net/Kconfig
@@ -6,6 +6,13 @@ menuconfig NETDEVICES

 if NETDEVICES

+config RVCNET
+	bool "RVE emulator network device (rvcnet)"
+	depends on NET && NETDEVICES && OF
+	help
+	  Platform Ethernet driver for the RVE RISC-V emulator.  Exchanges
+	  raw Ethernet frames with a peer emulator over a Unix socket.
+	  Say Y when building a Linux image for rve.
+
