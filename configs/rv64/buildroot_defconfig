# Buildroot defconfig for the rve RV64 (Sv39, S-mode) Linux image.
# Used by `make build ARCH=rv64` (docker/container.mk). Paths assume the docker layout
# (/workspace/project = this repo).

# Architecture: rv64imafd / lp64d (rve has no C extension)
BR2_riscv=y
BR2_RISCV_64=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVD=y
BR2_RISCV_ABI_LP64D=y

# Toolchain: musl keeps the userspace small and the toolchain build fast
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_5=y
BR2_TARGET_OPTIMIZATION="-Os"
BR2_OPTIMIZE_S=y
BR2_GLOBAL_PATCH_DIR="/workspace/project/patches"

# System
BR2_TARGET_GENERIC_HOSTNAME="rve"
BR2_TARGET_GENERIC_ISSUE="Welcome to RVE Buildroot (rv64)"
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="/workspace/project/configs/rootfsoverlay"
# builds hello_linux / pi / framebuff (the rv32 image's custom apps) into /root
BR2_ROOTFS_POST_BUILD_SCRIPT="/workspace/project/configs/rv64/post_build.sh"

# Userland extras (need an MMU, so rv64 only): vim + ncurses terminfo for it
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="/workspace/project/configs/rv64/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_VIM_RUNTIME=y
BR2_PACKAGE_NCURSES=y

# Root filesystem: cpio embedded in the kernel image as an initramfs
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y

# Kernel (same version and out-of-tree rve-kbd patch as the rv32 image)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.8-rc1"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="/workspace/project/configs/rv64/kernel_config"
BR2_LINUX_KERNEL_IMAGE=y

# Firmware: OpenSBI (M-mode) jumps to the kernel in S-mode at 0x80200000
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_LATEST_VERSION=y
BR2_TARGET_OPENSBI_PLAT="generic"
# rve has no C extension: build OpenSBI without compressed instructions (generic defaults to rv64imafdc)
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="FW_TEXT_START=0x80000000 FW_JUMP_ADDR=0x80200000 PLATFORM_RISCV_ISA=rv64ima_zicsr_zifencei PLATFORM_RISCV_ABI=lp64"
